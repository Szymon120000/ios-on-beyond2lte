diff --git a/pexpert/pexpert/arm/b2l_gicv2.h b/pexpert/pexpert/arm/b2l_gicv2.h
new file mode 100644
index 0000000..b07c877
--- /dev/null
+++ b/pexpert/pexpert/arm/b2l_gicv2.h
@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: BSD-2-Clause
+ * Exynos 9820 (beyond2lte) GICv2 CPU-interface access used by sleh_irq().
+ * The distributor is programmed once in pe_init_fiq(); the IRQ path only
+ * acknowledges and ends interrupts through the CPU interface.
+ */
+#ifndef _PEXPERT_ARM_B2L_GICV2_H_
+#define _PEXPERT_ARM_B2L_GICV2_H_
+
+#include <stdint.h>
+
+#if defined(B2L_BOARD)
+extern uint32_t b2l_gicv2_ack(void);
+extern void b2l_gicv2_eoi(uint32_t iar);
+extern int b2l_gicv2_is_timer(uint32_t intid);
+#else
+static inline uint32_t b2l_gicv2_ack(void) { return 1023; }
+static inline void b2l_gicv2_eoi(uint32_t iar) { (void)iar; }
+static inline int b2l_gicv2_is_timer(uint32_t intid) { (void)intid; return 0; }
+#endif
+
+#endif /* ! _PEXPERT_ARM_B2L_GICV2_H_ */
diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
index 6089db9..428093b 100644
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -13,6 +13,92 @@
 #include <pexpert/arm64/board_config.h>
 
 
+#if defined(B2L_BOARD)
+/*
+ * beyond2lte (Exynos 9820) GICv2.  TrustZone owns Group 0, so the timer and
+ * SGIs are programmed as Group 1 and arrive as IRQs, exactly like the SWEET
+ * GICv3 path.  GICC is banked per CPU, so secondary cores only need the
+ * CPU-interface half; the distributor is programmed once by the boot CPU.
+ */
+#include <pexpert/arm/b2l_gicv2.h>
+
+#define GICD_CTLR_DISABLE       0x0
+#define GICD_CTLR_ENABLE_GRP1   0x2
+#define GICC_CTLR_DISABLE       0x0
+#define GICC_CTLR_ENABLE_GRP1   0x2
+#define GICC_PMR_ALL            0xff
+#define GIC_PRIORITY_DEFAULT    0xa0
+
+static vm_offset_t b2l_gicd_base;
+static vm_offset_t b2l_gicc_base;
+
+static inline uint32_t
+b2l_gic_read(vm_offset_t base, uint32_t offset)
+{
+	return *(volatile uint32_t *)(base + offset);
+}
+
+static inline void
+b2l_gic_write(vm_offset_t base, uint32_t offset, uint32_t value)
+{
+	*(volatile uint32_t *)(base + offset) = value;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+uint32_t
+b2l_gicv2_ack(void)
+{
+	return b2l_gic_read(b2l_gicc_base, GICC_IAR);
+}
+
+void
+b2l_gicv2_eoi(uint32_t iar)
+{
+	b2l_gic_write(b2l_gicc_base, GICC_EOIR, iar);
+}
+
+int
+b2l_gicv2_is_timer(uint32_t intid)
+{
+	return intid == SWEET_VTIMER_INTID;
+}
+
+void
+pe_init_fiq(void)
+{
+	if (!b2l_gicd_base) {
+		b2l_gicd_base = ml_io_map(B2L_GICD_PA, 0x1000);
+		b2l_gicc_base = ml_io_map(B2L_GICC_PA, 0x2000);
+		if (!b2l_gicd_base || !b2l_gicc_base) {
+			panic("%s: cannot map the Exynos GICv2 regions", __func__);
+		}
+
+		/* Route PPIs and the first SPIs to Group 1, CPU 0. */
+		b2l_gic_write(b2l_gicd_base, GICD_CTLR, GICD_CTLR_DISABLE);
+		for (uint32_t i = 0; i < 32; i += 4) {
+			b2l_gic_write(b2l_gicd_base, GICD_IGROUPR + i, 0xffffffffU);
+			b2l_gic_write(b2l_gicd_base, GICD_IPRIORITYR + i,
+			    GIC_PRIORITY_DEFAULT * 0x01010101U);
+			b2l_gic_write(b2l_gicd_base, GICD_ITARGETSR + i, 0x01010101U);
+		}
+		/* Virtual timer PPI 27. */
+		b2l_gic_write(b2l_gicd_base, GICD_ISENABLER + ((SWEET_VTIMER_INTID / 32) * 4),
+		    1U << (SWEET_VTIMER_INTID % 32));
+		b2l_gic_write(b2l_gicd_base, GICD_CTLR, GICD_CTLR_ENABLE_GRP1);
+	}
+
+	b2l_gic_write(b2l_gicc_base, GICC_CTLR, GICC_CTLR_DISABLE);
+	b2l_gic_write(b2l_gicc_base, GICC_PMR, GICC_PMR_ALL);
+	b2l_gic_write(b2l_gicc_base, GICC_BPR, 0);
+	b2l_gic_write(b2l_gicc_base, GICC_CTLR, GICC_CTLR_ENABLE_GRP1);
+	__asm__ volatile("isb sy" ::: "memory");
+
+	kprintf("B2L GIC: GICv2 timer PPI %u, counter %u Hz\n",
+	    (unsigned)SWEET_VTIMER_INTID, (unsigned)B2L_COUNTER_HZ);
+}
+
+#else /* !B2L_BOARD */
+
 #if HAS_GIC_V3
 #define GICR_WAKE_TIMEOUT_NS (1000000000ULL) // timeout for redistributor wakeup (default 1s)
 MACHINE_TIMEOUT(gicr_wake_timeout_ns, "gicr-wake-timeout", GICR_WAKE_TIMEOUT_NS, MACHINE_TIMEOUT_UNIT_NSEC, NULL);
@@ -228,3 +314,5 @@ pe_init_fiq()
 {
 }
 #endif
+
+#endif /* !B2L_BOARD */
diff --git a/pexpert/pexpert/arm64/SWEET.h b/pexpert/pexpert/arm64/SWEET.h
index b99c2f4..e7fd7c3 100644
--- a/pexpert/pexpert/arm64/SWEET.h
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -1,12 +1,13 @@
 /*
- * Board config for the Redmi Note 10 Pro ("sweet", Qualcomm SM7150 /
- * Snapdragon 732G): Kryo 470 = Cortex-A76 + Cortex-A55, ARMv8.2, no PAC.
+ * Generic non-Apple ARM64 board config used by the hackios bring-up ports.
  *
- * Generic ARM like BCM2837 (no APPLE_ARM64_ARCH_FAMILY: none of Apple's
- * implementation-defined system registers exist), 16K pages and GICv3 like
- * VMAPPLE. Unlike VMAPPLE the GIC has two security states (GICD_TYPER
- * SecurityExtn=1): Group 0 belongs to TrustZone, so every interrupt,
- * including the timer, is a Group 1 IRQ taken through sleh_irq().
+ * The machine config keeps the historical SWEET name so the upstream patch
+ * series (HFS, libpthread, AMFI providers) applies unchanged.  A build may
+ * select a concrete board with -DB2L_BOARD=1: Samsung Galaxy S10+
+ * (beyond2lte, Exynos 9820), GICv2, 4KB-capable but currently 16K pages,
+ * architected virtual timer INTID 27, 26MHz counter.
+ *
+ * The default SWEET board is the Redmi Note 10 Pro (SM7150, GICv3, INTID 19).
  */
 
 #ifndef _PEXPERT_ARM64_SWEET_H
@@ -34,14 +35,44 @@
 #define __ARM_ENABLE_SWAP__       1
 #define __ARM_V8_CRYPTO_EXTENSIONS__ 1
 #define __ARM_PAN_AVAILABLE__     1
+
 #define __ARM_16K_PG__            1
 
+#if !defined(B2L_BOARD)
 #define HAS_GIC_V3                1
+#endif
 
 #ifndef ASSEMBLER
 #define PLATFORM_PANIC_LOG_DISABLED
 #endif /* ! ASSEMBLER */
 
+#if defined(B2L_BOARD)
+/* Exynos 9820 wires the architected virtual timer to the architectural PPI 27. */
+#define B2L_TIMER_INTID           27
+#define B2L_GICD_PA               0x10101000ULL
+#define B2L_GICC_PA               0x10102000ULL
+#define B2L_COUNTER_HZ            26000000ULL
+#define B2L_FB_BASE               0xCA000000ULL
+#define B2L_FB_WIDTH              1440U
+#define B2L_FB_HEIGHT              3040U
+#define B2L_FB_STRIDE             (B2L_FB_WIDTH * 4U)
+#define SWEET_VTIMER_INTID        B2L_TIMER_INTID
+#define SWEET_IPI_SGI             9       // SGI used for cross-CPU signals
+#define GIC_SPURIOUS_IRQ          1023
+/* GICv2 distributor / CPU interface registers (Arm IHI 0048B) */
+#define GICD_CTLR                 0x000
+#define GICD_CTLR_ENABLEGRP1      0x2
+#define GICD_IGROUPR              0x080
+#define GICD_ISENABLER            0x100
+#define GICD_IPRIORITYR           0x400
+#define GICD_ITARGETSR            0x800
+#define GICC_CTLR                 0x000
+#define GICC_CTLR_ENABLEGRP1      0x2
+#define GICC_PMR                  0x004
+#define GICC_BPR                  0x008
+#define GICC_IAR                  0x00C
+#define GICC_EOIR                 0x010
+#else
 /*
  * Qualcomm numbers the architected timer PPIs 1/2/3/0 (secure phys, phys,
  * virt, hyp) instead of the usual 13/14/11/10: the virtual timer XNU uses
@@ -49,6 +80,7 @@
  */
 #define SWEET_VTIMER_INTID        19
 #define SWEET_IPI_SGI             1       // SGI used for cross-CPU signals
+#endif
 
 #define GIC_SPURIOUS_IRQ          1023    // IRQ no. for GIC spurious interrupt
 
